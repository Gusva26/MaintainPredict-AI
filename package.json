{
  "name": "maintainpredict-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed:users": "pnpm --filter web db:seed:users",
    "db:seed:kb": "pnpm --filter web db:seed:kb",
    "db:seed": "pnpm --filter web db:seed:users && pnpm --filter web db:seed:kb"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
