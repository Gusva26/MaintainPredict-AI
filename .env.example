# ─── App ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# ─── Postgres ────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maintainpredict
POSTGRES_USER=mp_user
POSTGRES_PASSWORD=mp_pass_change_me
DATABASE_URL=postgresql://mp_user:mp_pass_change_me@postgres:5432/maintainpredict

# ─── JWT / RBAC ──────────────────────────────────────
JWT_SECRET=change_me_super_secret_at_least_32_chars_long
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── OpenAI (PredictorAgent + PlannerAgent + RAG) ────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: apunta a un proveedor compatible con la API de OpenAI.
# Déjalo vacío para usar el endpoint oficial de OpenAI.
#   OpenRouter → https://openrouter.ai/api/v1        (modelo: openai/gpt-4o)
#   Groq       → https://api.groq.com/openai/v1      (modelo: openai/gpt-oss-120b)
# OJO: el RAG necesita un proveedor de embeddings de 1536 dimensiones (OpenAI).
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# ─── Embeddings del RAG (Google Gemini, capa gratuita) ───
# Groq (arriba) da el chat pero NO ofrece embeddings, así que el RAG se
# vectoriza con Gemini. Clave gratuita en https://aistudio.google.com/apikey
# Si se deja vacía se intenta OPENAI_* y, si tampoco hay, embedding determinista.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── ML Service (FastAPI) ────────────────────────────
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_API_KEY=ml_internal_key_change_me

# ─── n8n ─────────────────────────────────────────────
N8N_HOST=n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_change_me
N8N_ENCRYPTION_KEY=change_me_32_chars_n8n_encryption
N8N_WEBHOOK_URL=http://web:3000/api/webhooks/n8n
N8N_API_KEY=n8n_api_key_change_me

# ─── n8n internos (auth servicio↔servicio) ───────────
# Consumidas por los workflows n8n (APP_BASE_URL, INTERNAL_TOKEN, SENSOR_API_KEY,
# SUPERVISOR_EMAIL) y por los endpoints internos de Next.js.
APP_BASE_URL=http://web:3000
# URL pública (navegador) para los enlaces de los emails de n8n. En prod: https://<APP_DOMAIN>
PUBLIC_APP_URL=http://localhost:3000
INTERNAL_TOKEN=change_me_internal_token_32_chars_long
N8N_WEBHOOK_BASE_URL=http://n8n:5678
SUPERVISOR_EMAIL=supervisor@mp.ai
SENSOR_API_KEY=sensor_key_change_me
REPORT_SHEET_ID=

# ─── Integraciones (mocks en desarrollo) ─────────────
# INTEGRATIONS_MODE=mock → todo simulado (por defecto en desarrollo).
# INTEGRATIONS_MODE=real → exige credenciales/productos reales (Twilio, SMTP real…).
INTEGRATIONS_MODE=mock
SCADA_BASE_URL=http://mock-scada:9000
SCADA_API_KEY=scada_key
ERP_BASE_URL=http://mock-erp:9001
ERP_API_KEY=erp_key
# SMS_PROVIDER: log (dry-run, por defecto) | mock (pasarela simulada) | twilio (real)
SMS_PROVIDER=log
SMS_BASE_URL=http://mock-sms:9002
SMS_ACCOUNT_SID=ACxxxxxxxx
SMS_AUTH_TOKEN=xxxxxxxx
SMS_FROM=+15550000000
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=maintainpredict@local
# Corte de las llamadas a integraciones externas (ms).
INTEGRATION_TIMEOUT_MS=5000

# ─── Agentes (fase E) ────────────────────────────────
# Corte por intento al llamar al microservicio ML (ms).
AGENT_TIMEOUT_MS=8000
# Reintentos ADICIONALES del servicio ML (2 ⇒ 3 intentos). El LLM no se
# reintenta: si falla, se usa el plan/relato de respaldo de inmediato.
AGENT_RETRIES=2
# Corte de cada llamada al LLM (ms).
LLM_TIMEOUT_MS=20000

# ─── Observabilidad ──────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=info
# Umbral de "alta probabilidad" con el que se cuentan los falsos positivos (H.7).
# Subirlo exige más confianza para alertar (menos FP, más riesgo de no actuar);
# bajarlo alerta antes. El panel de /observability permite simular otros valores.
FALSE_POSITIVE_THRESHOLD=0.70
# TTL de la caché en memoria del informe semanal (ms).
REPORT_CACHE_TTL_MS=60000

# ─── Reportes ────────────────────────────────────────
REPORTS_OUTPUT_DIR=/data/reports
UPLOAD_DIR=/data/uploads

# ─── Producción (docker-compose.prod.yml + infra/caddy/Caddyfile) ─
# Dominios públicos; Caddy sustituye {$VAR} y emite TLS automático (Let's Encrypt).
APP_DOMAIN=app.example.com
DOMAIN=example.com
N8N_HOST_EXTERNAL=n8n.example.com
# Registro de imágenes en ghcr.io (CI/CD). GITHUB_REPOSITORY_OWNER = org/usuario.
GITHUB_REPOSITORY_OWNER=my-org
TAG=latest
