    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.prediction_id, p.equipment_id, p.component, p.failure_probability, p.window_days, e.name AS equipment_name, e.criticality, e.downtime_cost_eur_h FROM predictions p JOIN equipment e ON e.equipment_id = p.equipment_id WHERE p.prediction_id = $1",
        "options": {
          "queryReplacement": "={{ $json.body.prediction_id }}"
        }
      },
      "id": "pg-02a",
      "name": "Postgres: recuperar predicción",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "mp_postgres",
          "name": "MaintainPredict Postgres"
        }
      },
      "alwaysOutputData": true
    },
