      "id": "wait-02",
      "name": "Wait: HITL (resume-on-webhook · 30 min)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1740,
        220
      ],
      "webhookId": "wf02-hitl-wait",
      "notes": "Se resuelve al decidir en /orders/:id (aprobar o rechazar). Timeout de 30 min como seguridad."
    },
    {
      "parameters": {
        "jsCode": "// Distingue las tres salidas de la espera: aprobar, rechazar y expirar.\n// Si la espera se reanuda por timeout, el item que entra no trae 'decision'.\nconst data = $input.first().json;\nconst body = data?.body ?? data ?? {};\nconst decision =\n  body.decision === 'approve' || body.decision === 'reject'\n    ? body.decision\n    // Compatibilidad con llamadas antiguas que solo enviaban { approved: true }.\n    : body.approved === true\n      ? 'approve'\n      : 'timeout';\n\nreturn [{\n  json: {\n    decision,\n    approved: decision === 'approve',\n    rejected: decision === 'reject',\n    expired: decision === 'timeout',\n    order_id: $('HTTP: POST /api/orders/auto-plan').item.json.data.order_id,\n  },\n}];"
      },
      "id": "code-02b",
      "name": "Evaluar respuesta HITL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        220
      ]
    },
