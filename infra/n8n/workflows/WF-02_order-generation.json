        "emailFormat": "html",
        "html": "=<h2>Orden de mantenimiento asignada</h2>\n<p>Orden <b>#{{$('HTTP: POST /api/orders/auto-plan').item.json.data.order_id}}</b></p>\n<ul>\n  <li>Fecha programada: {{$('HTTP: POST /api/orders/auto-plan').item.json.data.scheduled_date}}</li>\n  <li>Repuestos: {{JSON.stringify($('HTTP: POST /api/orders/auto-plan').item.json.data.parts)}}</li>\n  <li>Prioridad: {{$('HTTP: POST /api/orders/auto-plan').item.json.data.priority}}</li>\n</ul>\n<p><a href=\"{{ $env.PUBLIC_APP_URL || $env.APP_BASE_URL }}/technician\" style=\"background:#16a34a;color:#fff;padding:10px 20px;text-decoration:none;border-radius:6px\">Abrir App Técnico</a></p>",
        "options": {}
