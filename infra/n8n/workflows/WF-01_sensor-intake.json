{
  "id": "eErzFhJreegpfYig",
  "name": "WF-01 Sensor Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sensor-data",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "wh-01",
      "name": "Webhook: POST /sensor-data",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "wf01-sensor-intake",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza el payload. Acepta formatos:\n//   { sensor_id, value, recorded_at? }\n//   { sensor_id, value, equipment_id }\n//   { equipment_id, readings: [{ sensor_id, value }] }\nconst body = $input.first().json.body ?? $input.first().json;\n\nif (Array.isArray(body.readings)) {\n  return body.readings.map((r) => ({\n    json: {\n      sensor_id: Number(r.sensor_id),\n      value: Number(r.value),\n      recorded_at: r.recorded_at ?? new Date().toISOString(),\n      equipment_id: body.equipment_id ?? r.equipment_id ?? null,\n    },\n  }));\n}\n\nif (!body.sensor_id || body.value === undefined) {\n  throw new Error('Payload inválido: requiere sensor_id y value (o readings[])');\n}\n\nreturn [{\n  json: {\n    sensor_id: Number(body.sensor_id),\n    value: Number(body.value),\n    recorded_at: body.recorded_at ?? new Date().toISOString(),\n    equipment_id: body.equipment_id ?? null,\n  },\n}];"
      },
      "id": "code-01a",
      "name": "Normalizar payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/sensors/data",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" },
            { "name": "x-sensor-key", "value": "={{$env.SENSOR_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sensor_id: $json.sensor_id, value: $json.value, recorded_at: $json.recorded_at }) }}",
        "options": {
          "timeout": 15000,
          "response": { "response": { "neverError": false } }
        }
      },
      "id": "http-01-ingest",
      "name": "HTTP: POST /api/sensors/data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// El nodo anterior responde { data: { sensorId, ... } }: leer de ahi (o del payload normalizado).\nconst norm = $('Normalizar payload').item.json;\nconst sensorId = $json.data?.sensorId ?? norm.sensor_id;\nlet equipmentId = norm.equipment_id ?? $json.data?.equipmentId ?? null;\nif (!equipmentId) {\n  // Consulta rápida: obtener equipo del sensor\n  const res = await this.helpers.httpRequest({\n    method: 'GET',\n    url: `${$env.APP_BASE_URL}/api/sensors/${sensorId}`,\n    headers: { 'x-internal-token': $env.INTERNAL_TOKEN },\n    json: true,\n  });\n  equipmentId = res?.data?.sensor?.equipmentId ?? res?.sensor?.equipmentId;\n}\nif (!equipmentId) {\n  throw new Error('No se pudo resolver equipment_id para el sensor ' + sensorId);\n}\nreturn [{ json: { ...($json.data ?? {}), sensor_id: sensorId, equipment_id: equipmentId } }];"
      },
      "id": "code-01b",
      "name": "Resolver equipment_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300],
      "notes": "Necesario cuando el payload solo trae sensor_id"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/predict",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" },
            { "name": "x-internal-token", "value": "={{$env.INTERNAL_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ equipment_id: $json.equipment_id }) }}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "neverError": false } }
        }
      },
      "id": "http-01-predict",
      "name": "HTTP: POST /api/predict",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "Timeout 60s porque invoca ML + RAG + LLM"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.alert === true || $json.data.failure_probability > 0.7 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-01",
      "name": "IF: probability > 0.7",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.APP_BASE_URL}}/api/orders/auto-plan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" },
            { "name": "x-internal-token", "value": "={{$env.INTERNAL_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prediction_id: $json.data.prediction_id }) }}",
        "options": {
          "timeout": 90000,
          "response": { "response": { "neverError": false } }
        }
      },
      "id": "http-01-autoplan",
      "name": "HTTP: POST /api/orders/auto-plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 220],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "notes": "Timeout 90s porque invoca PlannerAgent (function calling + RAG)"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.data.requires_hitl }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-01b-hitl",
      "name": "IF: requires_hitl",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1700, 220]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$env.SUPERVISOR_EMAIL}}",
        "subject": "=⚠️ HITL: Aprobación requerida orden #{{$json.data.order_id}}",
        "emailFormat": "html",
        "html": "=<h2>Aprobación humana requerida</h2>\n<p>Se ha generado automáticamente la orden <b>#{{$json.data.order_id}}</b> tras detectar una predicción de falla con alta probabilidad.</p>\n<ul>\n  <li><b>Parada estimada:</b> {{$json.data.estimated_downtime_h}}h</li>\n  <li><b>Técnico propuesto:</b> {{$json.data.technician}}</li>\n  <li><b>Prioridad:</b> {{$json.data.priority}}</li>\n  <li><b>Programada:</b> {{$json.data.scheduled_date}}</li>\n</ul>\n<p><b>Razonamiento del PlannerAgent:</b></p>\n<blockquote>{{$json.data.reasoning}}</blockquote>\n<p><a href=\"{{ $env.PUBLIC_APP_URL || $env.APP_BASE_URL }}/orders/{{$json.data.order_id}}\" style=\"background:#2563eb;color:#fff;padding:10px 20px;text-decoration:none;border-radius:6px\">Revisar y aprobar en MaintainPredict</a></p>\n<p style=\"color:#64748b;font-size:12px\">Regla 23.3: parada estimada > 4h requiere aprobación humana.</p>",
        "options": {}
      },
      "id": "email-01-hitl",
      "name": "Email: aviso HITL inmediato",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1920, 140],
      "credentials": { "smtp": { "id": "mp_smtp", "name": "MaintainPredict SMTP" } }
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$env.SUPERVISOR_EMAIL}}",
        "subject": "=Nueva orden #{{$json.data.order_id}} (auto-aprobada)",
        "emailFormat": "html",
        "html": "=<h2>Orden generada automáticamente</h2>\n<p>Orden <b>#{{$json.data.order_id}}</b> para técnico <b>{{$json.data.technician}}</b>.</p>\n<p><a href=\"{{ $env.PUBLIC_APP_URL || $env.APP_BASE_URL }}/orders/{{$json.data.order_id}}\">Ver orden</a></p>",
        "options": {}
      },
      "id": "email-01-auto",
      "name": "Email: notificación orden auto",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1920, 300],
      "credentials": { "smtp": { "id": "mp_smtp", "name": "MaintainPredict SMTP" } }
    },
    {
      "parameters": {},
      "id": "noop-01",
      "name": "NoOp: sin acción",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1480, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, prediction: $('HTTP: POST /api/predict').item.json.data }) }}"
      },
      "id": "resp-01",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2160, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.SMTP_FROM}}",
        "toEmail": "={{$env.SUPERVISOR_EMAIL}}",
        "subject": "=❌ Error en WF-01 (sensor intake)",
        "emailFormat": "html",
        "html": "=<h2>Error en ingesta de sensores</h2>\n<p>Execution ID: {{$execution.id}}</p>\n<p>Workflow: {{$workflow.name}}</p>\n<p>Error: {{$json.error.message ?? 'desconocido'}}</p>\n<p>Payload: <pre>{{ JSON.stringify($json, null, 2) }}</pre></p>\n<p><a href=\"{{$env.N8N_URL}}/execution/{{$execution.id}}\">Ver ejecución en n8n</a></p>",
        "options": {}
      },
      "id": "email-01-error",
      "name": "Email: alerta error WF-01",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [640, 480],
      "credentials": { "smtp": { "id": "mp_smtp", "name": "MaintainPredict SMTP" } }
    },
    {
      "parameters": {},
      "id": "err-trigger-01",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [420, 480]
    }
  ],
  "connections": {
    "Webhook: POST /sensor-data": {
      "main": [
        [{ "node": "Normalizar payload", "type": "main", "index": 0 }],
        [{ "node": "Email: alerta error WF-01", "type": "main", "index": 0 }]
      ]
    },
    "Normalizar payload": {
      "main": [[{ "node": "HTTP: POST /api/sensors/data", "type": "main", "index": 0 }]]
    },
    "HTTP: POST /api/sensors/data": {
      "main": [[{ "node": "Resolver equipment_id", "type": "main", "index": 0 }]]
    },
    "Resolver equipment_id": {
      "main": [[{ "node": "HTTP: POST /api/predict", "type": "main", "index": 0 }]]
    },
    "HTTP: POST /api/predict": {
      "main": [[{ "node": "IF: probability > 0.7", "type": "main", "index": 0 }]]
    },
    "IF: probability > 0.7": {
      "main": [
        [{ "node": "HTTP: POST /api/orders/auto-plan", "type": "main", "index": 0 }],
        [{ "node": "NoOp: sin acción", "type": "main", "index": 0 }]
      ]
    },
    "HTTP: POST /api/orders/auto-plan": {
      "main": [[{ "node": "IF: requires_hitl", "type": "main", "index": 0 }]]
    },
    "IF: requires_hitl": {
      "main": [
        [{ "node": "Email: aviso HITL inmediato", "type": "main", "index": 0 }],
        [{ "node": "Email: notificación orden auto", "type": "main", "index": 0 }]
      ]
    },
    "Email: aviso HITL inmediato": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Email: notificación orden auto": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "NoOp: sin acción": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    },
    "Error Trigger": {
      "main": [[{ "node": "Email: alerta error WF-01", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true },
  "tags": [{ "name": "wf-01" }],
  "versionId": "2",
  "active": false
}
